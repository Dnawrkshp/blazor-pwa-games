@using System.Text

<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Class="war-board mud-width-full" Style="z-index: 1;">
    <PlayingCardStack ElementId="player-stack-1" Class="player-stack-1" Cards="@TopPlayer.Stack" Width="100" Height="100" Neat="false" />
    <div id="player-stack-middle" />
    <PlayingCardStack ElementId="player-stack-2" Class="player-stack-2" Cards="@BottomPlayer.Stack" Width="100" Height="100" Neat="false" />
</MudStack>

@code {
    [Parameter, EditorRequired] public WarPlayer TopPlayer { get; set; }
    [Parameter, EditorRequired] public WarPlayer BottomPlayer { get; set; }

}
