@using System.Text

<MudStack Row id="@ElementId">
    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="0">
        <PlayingCardStack ElementId="@DiscardElementId" Class="war-player-discard" Cards="@Player.Discard" Neat="false" Width="80" Height="150" />
        <MudText Typo="Typo.h5">@Player.Discard.Count</MudText>
    </MudStack>
    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="0">
        <PlayingCardStack ElementId="@DeckElementId" Class="war-player-deck" Cards="@Player.Deck.Cards" Neat="false" Width="80" Height="150" OnCardClicked="OnDeckClicked" />
        <MudText Typo="Typo.h5">@Player.Deck.Count</MudText>
    </MudStack>
</MudStack>

@code {
    [Parameter] public int PlayerId { get; set; }
    [Parameter, EditorRequired] public WarPlayer Player { get; set; }
    [Parameter] public EventCallback OnDeckClicked { get; set; }

    private string ElementId => $"war-player-{PlayerId}";
    private string DiscardElementId => $"{ElementId}-discard";
    private string DeckElementId => $"{ElementId}-deck";
}
