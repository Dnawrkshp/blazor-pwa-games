@using System.Text

<div @key="@Card.Uid" id="@ElementId" class="@($"{Class} playing-card")" @onclick="@OnClick">
    @if (Card.IsFaceUp)
    {
        <MudImage Src="@Card.GetImagePath()" Alt="@Card.ToString()" Height="@GetHeight()" Style="@Style" />
    }
    else
    {
        <MudImage Src="images/cards/back.png" Alt="Card Back" Height="@GetHeight()" Style="@Style" />
    }
</div>

@code {
    [CascadingParameter] private PlayingCardStack? Stack { get; set; }
    [Parameter, EditorRequired] public PlayingCard Card { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string ElementId => $"playing-card-{Card.Uid}";

    private int GetHeight()
    {
        return Size switch
        {
            Size.Small => 75,
            Size.Medium => 100,
            Size.Large => 150,
            _ => 100
        };
    }
}
